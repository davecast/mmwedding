# --- Resend (https://resend.com/api-keys) ---------------------------------------------
# API key used to email each RSVP to you.
RESEND_API_KEY=
# Sender. Until you verify a domain in Resend, only "onboarding@resend.dev" works, and it can
# only deliver to the email address of your own Resend account.
RESEND_FROM="Boda Marguin & María <onboarding@resend.dev>"
# Where the RSVP emails arrive (separate several addresses with commas).
RSVP_TO_EMAIL=

# --- Storage for answers and the blessings carousel (needed on Vercel) ----------------
# Vercel adds these when you connect an Upstash Redis database to the project. Leave them out
# locally to keep answers in ./data/rsvps.json and ./data/rsvps.csv instead.
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted as well.)
KV_REST_API_URL=
KV_REST_API_TOKEN=
